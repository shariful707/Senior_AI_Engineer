    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
