{
  "name": "document-intelligence",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "start": "node apps/api/src/server.js",
    "worker": "node apps/worker/src/main.js",
