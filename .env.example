PORT=3001
HOST=127.0.0.1
# Leave blank for durable SQLite local mode. Docker configures Postgres and Redis.
DATABASE_URL=
REDIS_URL=
DATA_DIR=./data
OCR_URL=http://127.0.0.1:8000
# Set the SAME secret for API, worker and OCR service when exposing on a network.
INTERNAL_TOKEN=
# Optional shared workspace access token. Required in NODE_ENV=production.
API_TOKEN=
CORS_ORIGIN=http://localhost:5173
EXTRACTION_MODE=offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
SEMANTIC_SEARCH=false
EMBEDDING_MODEL=text-embedding-3-small
MAX_UPLOAD_MB=25
MAX_PAGES=1200
MAX_TEXT_CHARS=2000000
MAX_SHEET_ROWS=10000
TESSERACT_CMD=
# Fresh local offline workspaces include synthetic example documents.
SEED_SAMPLE_DOCUMENTS=true
